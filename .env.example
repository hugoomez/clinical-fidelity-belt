# Copy this file to .env and fill in real values. NEVER commit .env.
# Nothing here is required to run the test suite or the demo: both are offline.

# "stub" (offline, the default) or "live" (real APIs)
ORCH_MODE=stub

# Idonia Connect Cloud (staging) — self-signed JWT from api_key + api_secret
IDONIA_BASE_URL=https://connect-staging.idonia.com
IDONIA_API_KEY=
IDONIA_API_SECRET=

# Idonia deployment identifiers. The defaults baked into the code are the ones
# the published results were produced with; override them for another tenant.
# IDONIA_DICOM_DESTINATION=dicom_hak_num14
# IDONIA_REPORT_DESTINATION=report_hak_num14
# IDONIA_MAGIC_LINK_ID=hacknum14

# Recog — plain API key in the X-API-Key header (rrk_... format)
RECOG_BASE_URL=https://api.recog.es
RECOG_API_KEY=

# Google Gemini — required by the LLM-as-a-Judge backend of belt layer 3.
# Get one at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
